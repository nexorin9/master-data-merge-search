# 主数据归并检索系统 · 凭据位模板
#
# 复制为 .env 后填写真实值。凭据一律从环境变量读取，不写入代码、不写入
# 本机工作区、不写入审计留痕与导出文件。本文件不含任何真实密钥。

# ── 主数据平台（MDM）────────────────────────────────────────────
# 主数据平台接口根地址，例如 https://mdm.intra.example/his
MDM_BASE_URL=
# 主数据平台访问令牌（请求头 Authorization: Bearer <token>）
MDM_API_TOKEN=
# 主数据平台请求超时（毫秒），默认 15000
MDM_TIMEOUT_MS=15000
# 院内字段名 → 内部规范字段名 的映射表路径（JSON）
MDM_FIELD_MAP=./config/mdm-field-map.json

# ── 模型端点（OpenAI-compatible）─────────────────────────────────
# 模型端点根地址，例如 https://llm.intra.example/v1
LLM_BASE_URL=
# 模型端点访问令牌（请求头 Authorization: Bearer <token>）
LLM_API_KEY=
# 模型名，例如 qwen2.5-instruct
LLM_MODEL=
# 单次模型调用超时（毫秒），默认 30000
LLM_TIMEOUT_MS=30000
# 网络错误与 5xx 的重试上限，默认 1
LLM_MAX_RETRIES=1
# 单批候选的模型并发上限，默认 4
LLM_CONCURRENCY=4
